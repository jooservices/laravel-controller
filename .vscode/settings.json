{
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": false,
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.tabSize": 2
  },
  "intelephense.environment.phpVersion": "8.5.0",
  "intelephense.environment.shortOpenTag": false,
  "intelephense.files.maxSize": 5000000,
  "php.validate.enable": false,
  "php.problems.exclude": {
    "vendor": true
  },
  "laravel-pint.enable": true,
  "laravel-pint.runInLaravelProject": false,
  "laravel-pint.executablePath": "${workspaceFolder}/tools/pint",
  "phpcs.enable": true,
  "phpcs.executablePath": "${workspaceFolder}/tools/phpcs",
  "phpcs.standard": "${workspaceFolder}/phpcs.xml",
  "phpcs.autoConfigSearch": false,
  "phpcs.showSources": true,
  "phpcbf.executablePath": "${workspaceFolder}/tools/phpcbf",
  "phpstan.enabled": true,
  "phpstan.configFile": "${workspaceFolder}/phpstan.neon",
  "phpstan.binPath": "${workspaceFolder}/tools/phpstan",
  "phpstan.memoryLimit": "512M",
  "phpmd.command": "${workspaceFolder}/tools/phpmd",
  "phpmd.rules": "${workspaceFolder}/phpmd.xml",
  "phpunit.php": "${workspaceFolder}/tools/php",
  "phpunit.phpunit": "${workspaceFolder}/vendor/bin/phpunit"
}
